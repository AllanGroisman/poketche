{
  "name": "poketche",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "PokeTche — coleção e marketplace de Pokémon TCG (monorepo)",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm -r test",
    "api": "pnpm --filter @poketche/api",
    "mobile": "pnpm --filter @poketche/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
