# === PokeTche API — variáveis de ambiente ===
# Copie para apps/api/.env e preencha. NUNCA commite o .env (constituição: segredos fora do repo).

# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco (Postgres 16 — docker compose up -d db; host 5434 p/ evitar conflito com outro Postgres na 5432)
DATABASE_URL=postgresql://poketche:poketche@localhost:5434/poketche

# Auth (Supabase) — verificação de JWT (a API só valida o token via JWKS; não usa chave do Supabase)
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Catálogo (T016–T018)
POKEMONTCG_API_KEY=
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# Timeout (ms) das chamadas HTTP de catálogo. Suba se a pokemontcg.io estiver lenta.
CATALOG_HTTP_TIMEOUT_MS=60000

# Precificação (US3, T036–T038) — a fonte internacional (USD via TCGplayer/pokemontcg.io +
# PTAX/BACEN) opera desde o dia 1. A coleta da Liga fica DESLIGADA até o parecer legal (T034):
# só ligar PRICING_LIGA_ENABLED=true (e definir LIGA_BASE_URL) após aprovação.
INTL_PRICE_BASE_URL=https://api.pokemontcg.io/v2
PTAX_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
PRICING_SANITY_MAX_FACTOR=5
PRICING_LIGA_ENABLED=false
LIGA_BASE_URL=

# Object storage — imagens de catálogo e evidências de disputa (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMAGES=poketche-images
R2_BUCKET_DISPUTES=poketche-disputes

# Pagamentos (Pagar.me) — apenas após o spike de custódia (T076)
PAGARME_API_KEY=

# Push (Expo)
EXPO_ACCESS_TOKEN=

# Wishlists (US9) — intervalo mínimo entre dois pushes da mesma carta (FR-047)
WISHLIST_ALERT_MIN_INTERVAL_HOURS=24

# Scanner (US5) — OCR self-hosted (tesseract.js), sem credencial. Ver research.md §3.
SCANNER_CONFIDENCE_THRESHOLD=0.6
SCANNER_MAX_CROP_KB=1024

# NOTA: Client ID/Secret do Google OAuth NÃO vão aqui — vão no painel do Supabase
# (Authentication > Providers > Google). A publishable key do Supabase (sb_publishable_...)
# vai no app mobile, não na API.