{
  "expo": {
    "name": "PokeTche",
    "slug": "poketche",
    "scheme": "poketche",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poketche.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O PokeTche usa a câmera para escanear suas cartas e adicioná-las à coleção."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.poketche.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "O PokeTche usa a câmera para escanear suas cartas e adicioná-las à coleção.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "O PokeTche precisa de acesso para salvar o vídeo da sua sessão de escaneamento.",
          "savePhotosPermission": "O PokeTche salva o vídeo da sua sessão de escaneamento na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
