{
  "expo": {
    "name": "PokeTche",
    "slug": "poketche",
    "scheme": "poketche",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poketche.app"
    },
    "android": {
      "package": "com.poketche.app"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "O PokeTche usa a câmera para escanear suas cartas e adicioná-las à coleção.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "O PokeTche precisa de acesso para salvar o vídeo da sua sessão de escaneamento.",
          "savePhotosPermission": "O PokeTche salva o vídeo da sua sessão de escaneamento na sua galeria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api/v1",
      "supabaseUrl": "https://wdzdsujbhqwnxphlxvwe.supabase.co",
      "supabasePublishableKey": "sb_publishable_3Vl98hNaNcRUn0AdBN6PQg_K5t7pNWX"
    }
  }
}
