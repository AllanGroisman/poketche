auto-install-peers=true
strict-peer-dependencies=false
# node_modules achatado (igual npm/yarn). Necessário para o autolinking do React Native/Expo
# resolver corretamente no EAS — o layout isolado padrão do pnpm gera nomes de classe antigos
# (ex.: expo.core.ExpoModulesPackage) e quebra o build Android nativo.
node-linker=hoisted
